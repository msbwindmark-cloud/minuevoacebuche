# ============================================================================
# CONFIGURACION - Centro Ecuestre El Acebuche
# ============================================================================
# Este archivo contiene las credenciales. NO se sube a git (.gitignore).
# Copia de referencia: .env.example
#
# MODO DEMO: mientras MODO_DEMO=1 la app simula IA y Google Maps en local,
# asi puedes probarla sin credenciales reales. Pon MODO_DEMO=0 cuando vayas
# a usar las credenciales de verdad de Lucia.
# ============================================================================

# --- Django ---
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tudominio.pythonanywhere.com

# ============================================================================
# CREDENCIALES DE LUCIA (pedir a Lucia y ponerlas aqui)
# ============================================================================
# Cada bloque indica que variable rellenar y donde conseguir el valor.
# Mientras esten vacias o con el texto de ejemplo, la app sigue funcionando
# en MODO DEMO (simulaciones locales).

# --- Correo Hostalia - info@elacebuche.es ---
# EMAIL_HOST_PASSWORD: contrasena del correo info@elacebuche.es (Hostalia).
#   -> La tiene Lucia.
# EMAIL_HOST=imap.servidor-correo.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=info@elacebuche.es
# EMAIL_HOST_PASSWORD=CONTRASENA_DE_HOSTALIA_DE_LUCIA
# DEFAULT_FROM_EMAIL=info@elacebuche.es

# --- IMAP para leer correos entrantes (Hostalia) ---
# IMAP_PASSWORD: misma contrasena que el correo (Hostalia).
#   -> La tiene Lucia.
# IMAP_HOST=imap.servidor-correo.net
# IMAP_PORT=993
# IMAP_USER=info@elacebuche.es
# IMAP_PASSWORD=CONTRASENA_DE_HOSTALIA_DE_LUCIA
# IMAP_CARPETA_ENTRADA=INBOX
# IMAP_CARPETA_PROCESADO=Procesado
IMAP_REVISAR_CADA_HORAS=3

# --- Google Calendar ---
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: se crean en Google Cloud Console.
#   -> Lucia los crea en Google Cloud (proyecto propio).
# Despues hay que autorizar una vez en: http://localhost:8000/calendar/autorizar/
GOOGLE_CALENDAR_ID=luciagilran2014@gmail.com
GOOGLE_CALENDAR_NAME=Centro Ecuestre el Acebuche
GOOGLE_CLIENT_ID=CLIENT_ID_DE_GOOGLE_CLOUD_DE_LUCIA
GOOGLE_CLIENT_SECRET=CLIENT_SECRET_DE_GOOGLE_CLOUD_DE_LUCIA
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/oauth2callback/
GOOGLE_TOKEN_FILE=google_token.json
GOOGLE_CREDENTIALS_FILE=google_client_secrets.json

# --- Google Maps Platform ---
# GOOGLE_MAPS_API_KEY: API key de Google Maps Platform (Geocoding + Distance Matrix).
#   -> Lucia la crea en Google Cloud.
GOOGLE_MAPS_API_KEY=API_KEY_DE_GOOGLE_MAPS_DE_LUCIA

# --- IA para interpretar respuestas de clientes ---
# IA_PROVEEDOR: claude u openai.
# IA_API_KEY: clave de Anthropic (Claude) o OpenAI.
#   -> Lucia la consigue en Anthropic o OpenAI.
IA_PROVEEDOR=claude
IA_API_KEY=API_KEY_DE_IA_DE_LUCIA

# ============================================================================
# PRUEBAS DEL DESARROLLADOR (no usar en produccion)
# ============================================================================
# Si quieres probar el flujo real de correos con tu propio Gmail, descomenta
# y rellena estas lineas (y comenta las de Hostalia de arriba). Recuerda
# activar IMAP en Gmail y usar una App Password de 16 caracteres.
#
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=msb.coin@gmail.com
EMAIL_HOST_PASSWORD=irkcjuodosbaijrq
DEFAULT_FROM_EMAIL=msb.coin@gmail.com
#
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=msb.coin@gmail.com
IMAP_PASSWORD=irkcjuodosbaijrq
IMAP_CARPETA_ENTRADA=INBOX
IMAP_CARPETA_PROCESADO=Procesado

# ============================================================================
# Modo demo y otros
# ============================================================================
# MODO_DEMO: 1 = simula IA y Maps en local sin credenciales reales.
#            0 = usa las credenciales reales de Lucia (produccion).
MODO_DEMO=1

# --- Precio transporte fijo (segun el Word) ---
PRECIO_TRANSPORTE=60.00

# --- Avisos urgentes (dias de antelacion) ---
AVISO_RESERVA_PROXIMA_DIAS=1
